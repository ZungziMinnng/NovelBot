# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# Keep the frontend Build page despite the generic Python build/ ignore.
!frontend/src/pages/Build/
!frontend/src/pages/Build/**

# Virtual environments
venv/
.venv/
env/
.env.venv/

# ── Backend runtime data (do NOT commit) ────────────────────────────────────
backend/data/
backend/.env
tmp_*
data/

# ── Frontend ─────────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/

# 前端构建产物，打包脚本生成后由后端托管
backend/web/

# 分发包产物（打包脚本默认输出到仓库外，这里兜底防手滑）
release/
NovelBot-dist*/

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Editor ───────────────────────────────────────────────────────────────────
.idea/
*.swp
*.swo
