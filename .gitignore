# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# Keep the frontend Build page despite the generic Python build/ ignore.
!frontend/src/pages/Build/
!frontend/src/pages/Build/**

# Virtual environments
venv/
.venv/
env/
.env.venv/

# ── Backend runtime data (do NOT commit) ────────────────────────────────────
backend/data/
# 写 .env* 而不是 .env：精确名字只能挡住那一个文件，带后缀的备份
# （.env.bak.proxy / .env.local / .env.old）全都会漏过去——真漏过一次，
# 三个真 key 跟着上了公开仓库。模板文件保留在库里给人抄
backend/.env*
!backend/.env.example
tmp_*
data/

# ── Frontend ─────────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/

# 前端构建产物，打包脚本生成后由后端托管
backend/web/

# 分发包产物（打包脚本默认输出到仓库外，这里兜底防手滑）
release/
NovelBot-dist*/

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Editor ───────────────────────────────────────────────────────────────────
.idea/
*.swp
*.swo
