{
  "name": "新{{ label }}的名字",
  "category": "{% if is_rule %}留空字符串{% else %}类型 / 类别，自由文本{% endif %}",
  "level": "{% if is_rule %}留空字符串{% else %}稀有度 / 强度，自由文本{% endif %}",
  "description": "{% if is_rule %}规则的正文：约束什么、允许什么、违反的后果{% else %}一句话说清这是什么，用来在列表里认出它{% endif %}",
  "detail": "{% if is_rule %}留空字符串{% else %}使用方式、限制、副作用、代价{% endif %}"
}

