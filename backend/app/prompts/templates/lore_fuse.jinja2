{% endif %}{% if s.category %}类别：{{ s.category }}
{% endif %}{% if s.level %}强度：{{ s.level }}
{% endif %}{% if s.description %}描述：{{ s.description }}
{% endif %}{% if s.detail %}细节：{{ s.detail }}
{% endif %}
{% endfor %}
